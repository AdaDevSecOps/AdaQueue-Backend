# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api

# Database (SQL Server)
DB_TYPE=mssql
DB_HOST=localhost
DB_PORT=1433
DB_USERNAME=sa
DB_PASSWORD=
DB_DATABASE=AdaQueueDB
DB_SYNCHRONIZE=true
DB_LOGGING=true

# Security
JWT_SECRET=secret
CORS_ORIGIN=*

# Business Logic
DEFAULT_INDUSTRY=RESTAURANT
MAX_QUEUE_PER_DAY=1000

# Integration
POS_WEBHOOK_URL=http://localhost:3000/api/integration/pos/webhook
KDS_WEBHOOK_URL=http://localhost:3000/api/integration/kds/webhook
